<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kharchamate.resumaster"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="35" />

    <permission
        android:name="com.kharchamate.resumaster.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.kharchamate.resumaster.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.ResuMaster" >
        <activity
            android:name="com.kharchamate.resumaster.ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Starting" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.kharchamate.resumaster.ui.onboarding.OnboardingActivity"
            android:exported="false" />
        <activity
            android:name="com.kharchamate.resumaster.ui.dashboard.DashboardActivity"
            android:exported="false" />
        <activity
            android:name="com.kharchamate.resumaster.ui.dashboard.CreateResumeActivity"
            android:exported="false" />
        <activity
            android:name="com.kharchamate.resumaster.ui.template.TemplateSelectionActivity"
            android:exported="false" />
        <activity
            android:name="com.kharchamate.resumaster.ui.builder.ResumeBuilderActivity"
            android:exported="false" />
        <activity
            android:name="com.kharchamate.resumaster.ui.builder.EducationActivity"
            android:exported="false" />
        <activity
            android:name="com.kharchamate.resumaster.ui.builder.ExperienceActivity"
            android:exported="false" />
        <activity
            android:name="com.kharchamate.resumaster.ui.builder.SkillsProjectsActivity"
            android:exported="false" />
        <activity
            android:name="com.kharchamate.resumaster.ui.builder.SummaryPreviewActivity"
            android:exported="false" />
        <activity
            android:name="com.kharchamate.resumaster.ui.builder.AiResumeActivity"
            android:exported="false" />
        <activity
            android:name="com.kharchamate.resumaster.ui.builder.ResumePdfPreviewActivity"
            android:exported="false" />
        <activity
            android:name="com.kharchamate.resumaster.ui.dashboard.MyResumeActivity"
            android:exported="false" />
        <activity
            android:name="com.kharchamate.resumaster.ui.dashboard.AiImproveActivity"
            android:exported="false" />
        <activity
            android:name="com.kharchamate.resumaster.ui.dashboard.ExportResumeActivity"
            android:exported="false" />
        <activity
            android:name="com.kharchamate.resumaster.ui.dashboard.TemplateActivity"
            android:exported="false" />
        <activity
            android:name="com.kharchamate.resumaster.ui.dashboard.ProfileActivity"
            android:exported="false" />
        <activity
            android:name="com.kharchamate.resumaster.MainActivity"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.kharchamate.resumaster.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <uses-library
            android:name="androidx.window.extensions"
            android:required="false" />
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>